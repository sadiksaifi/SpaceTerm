[[ -o interactive ]] || return 0
[[ "$SPACETERM_SHELL_INTEGRATION_VERSION" == 1 ]] || return 0
[[ -z "${_SPACETERM_INTEGRATION_LOADED:-}" ]] || return 0
typeset -g _SPACETERM_INTEGRATION_LOADED=1
typeset -gi _spaceterm_command_active=0
# The session's Prompt Owner marks this shell's own prompt markers; only hex is accepted.
case "${SPACETERM_PROMPT_OWNER:-}" in
    ''|*[!0-9a-f]*) typeset -g _spaceterm_owner= ;;
    *) typeset -g _spaceterm_owner=";spaceterm=$SPACETERM_PROMPT_OWNER" ;;
esac

autoload -Uz add-zsh-hook
# Encode protocol fields bytewise so delimiters and UTF-8 survive OSC parsing.
_spaceterm_encode() (
    LC_ALL=C
    export LC_ALL
    builtin printf '%s' "$1" | command od -An -v -tx1 | command awk '
        function byte_value(hex, digits) {
            digits = "0123456789abcdef"
            hex = tolower(hex)
            return (index(digits, substr(hex, 1, 1)) - 1) * 16 \
                + index(digits, substr(hex, 2, 1)) - 1
        }
        {
            for (index_ = 1; index_ <= NF; index_++) {
                byte = byte_value($index_)
                if ((byte >= 48 && byte <= 57) \
                        || (byte >= 65 && byte <= 90) \
                        || (byte >= 97 && byte <= 122) \
                        || byte == 45 || byte == 46 || byte == 47 \
                        || byte == 95 || byte == 126) {
                    printf "%c", byte
                } else {
                    printf "%%%s", toupper($index_)
                }
            }
        }
    '
)
_spaceterm_report_directory() {
    builtin printf '\e]7;file://localhost%s\a' "$(_spaceterm_encode "$PWD")"
}
_spaceterm_before_prompt() {
    builtin local -i cmd_status=$?
    if (( _spaceterm_command_active )); then
        builtin printf '\e]133;D;%d%s\a' "$cmd_status" "$_spaceterm_owner"
        _spaceterm_command_active=0
    fi
    _spaceterm_report_directory
    if [[ -n "${_spaceterm_marked_ps1+x}" && "$PS1" == "$_spaceterm_marked_ps1" ]]; then
        PS1=$_spaceterm_saved_ps1
    fi
    typeset -g _spaceterm_saved_ps1=$PS1
    # Zsh prints PS1 again on SIGWINCH without running precmd.
    [[ "$PS1" == *']133;A'* ]] || PS1=$'%{\e]133;A;redraw=1'"$_spaceterm_owner"$'\a%}'"$PS1"
    [[ "$PS1" == *']133;B'* ]] || PS1+=$'%{\e]133;B\a%}'
    typeset -g _spaceterm_marked_ps1=$PS1
}
_spaceterm_before_command() {
    builtin printf '\e]133;C;cmdline=%s%s\a' "$(_spaceterm_encode "$1")" "$_spaceterm_owner"
    _spaceterm_command_active=1
}
add-zsh-hook chpwd _spaceterm_report_directory
add-zsh-hook precmd _spaceterm_before_prompt
add-zsh-hook preexec _spaceterm_before_command

# An automatic call can look like a prompt callback from inside another shell hook or a
# ZLE widget. Only mark functions assigned exclusively to precmd.
_spaceterm_is_prompt_hook() {
    builtin local hook=$1
    case $hook in
        _spaceterm_*|TRAP*|chpwd|periodic|preexec|zshaddhistory|zshexit|zsh_directory_name|command_not_found_handler)
            return 1 ;;
    esac
    [[ $hook == precmd || ${precmd_functions[(Ie)$hook]-0} != 0 ]] &&
        (( ${chpwd_functions[(Ie)$hook]-0} == 0 &&
           ${periodic_functions[(Ie)$hook]-0} == 0 &&
           ${preexec_functions[(Ie)$hook]-0} == 0 &&
           ${zshaddhistory_functions[(Ie)$hook]-0} == 0 &&
           ${zshexit_functions[(Ie)$hook]-0} == 0 &&
           ${zsh_directory_name_functions[(Ie)$hook]-0} == 0 )) &&
        ! builtin zle
}

# A list trap runs in the prompt hook's scope, so the export disappears when the hook returns.
# Calls from startup files and submitted commands have different evaluation contexts.
# Leave an existing DEBUG handler in charge. A handler installed later can replace this one.
if [[ -n $_spaceterm_owner && $(builtin trap) != *DEBUG* ]]; then
    builtin trap '
        if [[ $ZSH_EVAL_CONTEXT == shfunc:trap && $# == 0 && -n ${funcstack[1]-} &&
              ${SPACETERM_PROMPT_HELPER-} != "$SPACETERM_PROMPT_OWNER:$$" ]] &&
           _spaceterm_is_prompt_hook "${funcstack[1]}"; then
            builtin local -x SPACETERM_PROMPT_HELPER="$SPACETERM_PROMPT_OWNER:$$"
        fi
    ' DEBUG
fi
