+test "kittygfx animation: frame edit and composition enforce conversion quota" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    const io = testing.io;
+    const cases = [_]struct {
+        transmit: []const u8,
+        update: []const u8,
+        original: []const u8,
+        updated: []const u8,
+    }{
+        .{
+            .transmit = "a=t,f=24,s=1,v=1,i=1;AQID",
+            .update = "a=f,f=32,s=1,v=1,i=1,r=1,X=1;BQYHCA==",
+            .original = &.{ 1, 2, 3 },
+            .updated = &.{ 5, 6, 7, 8 },
+        },
+        .{
+            .transmit = "a=t,f=24,s=2,v=1,i=1;AQIDBAUG",
+            .update = "a=c,i=1,r=1,c=1,w=1,h=1,x=1",
+            .original = &.{ 1, 2, 3, 4, 5, 6 },
+            .updated = &.{ 1, 2, 3, 255, 1, 2, 3, 255 },
+        },
+    };
+    for (cases) |case| {
+        for ([_]enum { reject, fits, evict }{ .reject, .fits, .evict }) |mode| {
+            var t = try Terminal.init(io, alloc, .{ .rows = 5, .cols = 5 });
+            defer t.deinit(alloc);
+            const storage = &t.screens.active.kitty_images;
+            const limit = switch (mode) {
+                .reject => case.original.len,
+                .fits => case.updated.len,
+                .evict => case.original.len + 3,
+            };
+            storage.setLimit(io, alloc, t.screens.active, limit);
+            {
+                const cmd = try command.Parser.parseString(alloc, case.transmit);
+                defer cmd.deinit(alloc);
+                try testing.expect(execute(io, alloc, &t, &cmd).?.ok());
+            }
+            if (mode == .evict) {
+                const cmd = try command.Parser.parseString(alloc, "a=T,f=24,s=1,v=1,i=2;AQID");
+                defer cmd.deinit(alloc);
+                try testing.expect(execute(io, alloc, &t, &cmd).?.ok());
+                try testing.expectEqual(@as(usize, 1), storage.placements.count());
+            }
+            const generation = storage.imageById(1).?.generation;
+            const cmd = try command.Parser.parseString(alloc, case.update);
+            defer cmd.deinit(alloc);
+            const resp = execute(io, alloc, &t, &cmd).?;
+            const img = storage.imageById(1).?;
+            if (mode == .reject) {
+                try testing.expectEqualStrings("ENOMEM: out of memory", resp.message);
+                try testing.expectEqual(case.original.len, storage.total_bytes);
+                try testing.expectEqualSlices(u8, case.original, img.data.bytes().?);
+                try testing.expectEqual(generation, img.generation);
+                try testing.expect(img.animation == null);
+            } else {
+                try testing.expect(resp.ok());
+                try testing.expectEqual(case.updated.len, storage.total_bytes);
+                try testing.expectEqualSlices(u8, case.updated, img.data.bytes().?);
+                try testing.expect(img.generation > generation);
+                if (mode == .evict) {
+                    try testing.expect(storage.imageById(2) == null);
+                    try testing.expectEqual(@as(usize, 0), storage.placements.count());
+                }
+            }
+            try testing.expect(storage.total_bytes <= storage.total_limit);
+        }
+    }
