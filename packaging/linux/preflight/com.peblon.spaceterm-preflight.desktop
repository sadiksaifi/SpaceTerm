[Desktop Entry]
Type=Application
Name=SpaceTerm Preflight
Comment=Terminal multiplexer
Exec=spaceterm-preflight-desktop %u
MimeType=x-scheme-handler/spaceterm;
Icon=com.peblon.spaceterm-preflight
Terminal=false
StartupNotify=true
StartupWMClass=com.peblon.spaceterm-preflight
Categories=System;TerminalEmulator;
