# Fill signing.yml locally, then encrypt it into signing.yml.vault.
# This is a personal backup. Release jobs read these values from the release environment's
# GitHub Actions secrets. The backup update key never enters this file or GitHub.
SPACETERM_RELEASE_DEVID_P12_BASE64: ""
SPACETERM_RELEASE_DEVID_P12_PASSWORD: ""
SPACETERM_RELEASE_NOTARY_P8: ""
SPACETERM_RELEASE_NOTARY_KEY_ID: ""
SPACETERM_RELEASE_NOTARY_ISSUER_ID: ""
SPACETERM_RELEASE_UPDATE_ED25519_SEED: ""
