+pub fn grid_ref_hyperlink_userdata(
+    ref: *const CGridRef,
+    out_buf: ?[*]u8,
+    buf_len: usize,
+    out_len: *usize,
+) callconv(lib.calling_conv) Result {
+    const p = ref.toPin() orelse return .invalid_value;
+    const terminal_page = p.node.page();
+    const cell = terminal_page.getRowAndCell(p.x, p.y).cell;
+
+    if (!cell.hyperlink) {
+        out_len.* = 0;
+        return .success;
+    }
+
+    const link_id = terminal_page.lookupHyperlink(cell) orelse {
+        out_len.* = 0;
+        return .success;
+    };
+    const userdata = terminal_page.hyperlink_set.get(
+        terminal_page.memory,
+        link_id,
+    ).userdata.slice(terminal_page.memory);
+    if (out_buf == null or buf_len < userdata.len) {
+        out_len.* = userdata.len;
+        return .out_of_space;
+    }
+    @memcpy(out_buf.?[0..userdata.len], userdata);
+    out_len.* = userdata.len;
+    return .success;
+}
