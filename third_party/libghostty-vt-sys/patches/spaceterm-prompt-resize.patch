+pub fn finishPendingPromptWithOutput(self: *Screen) void {
+    const pending = self.pending_prompt_redraw orelse return;
+    if (!pending.start.garbage) {
+        while (true) {
+            const start_y = self.pages.pointFromPin(.screen, pending.start.*).?.screen.y;
+            const cursor_y = self.pages.pointFromPin(.screen, self.cursor.page_pin.*).?.screen.y;
+            if (start_y >= cursor_y) break;
