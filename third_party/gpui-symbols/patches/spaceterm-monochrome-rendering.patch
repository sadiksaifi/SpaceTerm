+    /// SpaceTerm regression test for `patches/spaceterm-monochrome-rendering.patch`.
+    ///
+    /// Upstream built the monochrome configuration so that the hierarchical tint was applied
+    /// last, and `configurationByApplyingConfiguration:` gives precedence to the applied
+    /// configuration. `RenderingMode::Monochrome` therefore collapsed into
+    /// `RenderingMode::Hierarchical`, and every multi-layer symbol painted its secondary layer at
+    /// reduced alpha.
+    ///
+    /// The defect is carried by alpha rather than by color: the secondary layer keeps the
+    /// requested color and is composited at a lower opacity, so comparing colors alone cannot
+    /// detect it. A single-layer symbol has no secondary layer and so must look the same in both
+    /// modes; it serves as the control that keeps this test honest.
+    #[test]
+    #[ignore = "requires GUI environment"]
+    #[cfg(target_os = "macos")]
+    fn monochrome_should_not_dim_the_secondary_layer_of_a_badged_symbol() {
+        /// Antialiasing makes the two modes disagree by a hair even where they should match.
+        const ANTIALIASING_TOLERANCE: u8 = 2;
+        const COLOR: u32 = 0x00cd_cdcd;
+
+        fn render(name: &str, mode: RenderingMode) -> Vec<u8> {
+            SfSymbol::new(name)
+                .size(64.0)
+                .color(COLOR)
+                .rendering_mode(mode)
+                .render_rgba()
+                .unwrap_or_else(|| panic!("{name} did not render"))
+                .2
+        }
+
+        fn largest_difference(name: &str) -> u8 {
+            let monochrome = render(name, RenderingMode::Monochrome);
+            let hierarchical = render(name, RenderingMode::Hierarchical);
+            assert_eq!(
+                monochrome.len(),
+                hierarchical.len(),
+                "{name} rendered different bitmap sizes per mode"
+            );
+            monochrome
+                .iter()
+                .zip(&hierarchical)
+                .map(|(left, right)| left.abs_diff(*right))
+                .max()
+                .unwrap_or(0)
+        }
+
+        let badged = largest_difference("folder.badge.plus");
+        let single_layer = largest_difference("magnifyingglass");
+
+        assert!(
+            single_layer <= ANTIALIASING_TOLERANCE,
+            "a single-layer symbol differed between modes by {single_layer}, so this test is \
+             measuring something other than secondary-layer dimming"
+        );
+        assert!(
+            badged > ANTIALIASING_TOLERANCE,
+            "monochrome and hierarchical agreed on a badged symbol (largest difference \
+             {badged}), so monochrome collapsed into hierarchical and the secondary layer is \
+             still dimmed"
+        );
+    }
+
     #[test]
     #[ignore = "requires GUI environment"]
     #[cfg(target_os = "macos")]
