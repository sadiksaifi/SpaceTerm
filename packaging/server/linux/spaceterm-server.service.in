[Unit]
Description=SpaceTerm Server (@BUILD@)
# The service has no finite restart counter. A credential-free unprivileged
# storage-wait path may exit with a retry failure after checking the same identity.
StartLimitIntervalSec=0

[Service]
Type=exec
User=root
ExecStart="@LAUNCHER_PATH@" --build @BUILD@ --account-uid @ACCOUNT_UID@ --registration-generation @REGISTRATION_GENERATION@
WorkingDirectory=/
Restart=on-failure
RestartSec=20s
# Stopped admission returns 0 and cannot enter a restart loop.
SuccessExitStatus=0
# The server's SIGTERM handler must drain started writes. Only the tracked
# server receives SIGTERM; no finite timer kills its Git-write children.
KillMode=mixed
TimeoutStopSec=infinity
SendSIGKILL=no
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
