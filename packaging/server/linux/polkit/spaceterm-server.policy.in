        </defaults>
        <annotate key="org.freedesktop.policykit.exec.path">@MANAGER_PATH@</annotate>
        <annotate key="org.freedesktop.policykit.exec.argv1">start</annotate>
    </action>
    <action id="@SERVER_IDENTIFIER@.manage.stop">
        <description>SpaceTerm Server: stop</description>
        <message>Authorize SpaceTerm Server stop</message>
        <defaults>
