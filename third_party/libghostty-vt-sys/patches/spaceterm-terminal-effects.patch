+        &terminal,
+        .{ .cols = 80, .rows = 24, .max_scrollback = 10_000 },
+    ));
+    defer terminal_c.free(terminal);
+
+    try terminal.?.terminal.screens.active.startHyperlinkWithUserdata(
+        "file:///tmp/example",
+        "same-id",
+        .{ 1, 2, 3 },
+    );
+    terminal_c.vt_write(terminal, "a", 1);
+    terminal.?.terminal.screens.active.endHyperlink();
+    try terminal.?.terminal.screens.active.startHyperlinkWithUserdata(
+        "file:///tmp/example",
+        "same-id",
+        .{ 4, 5, 6 },
+    );
+    terminal_c.vt_write(terminal, "b", 1);
+    terminal.?.terminal.screens.active.endHyperlink();
+
+    for ([_]struct { x: u16, expected: [3]u8 }{
+        .{ .x = 0, .expected = .{ 1, 2, 3 } },
+        .{ .x = 1, .expected = .{ 4, 5, 6 } },
+    }) |case| {
+        var ref: CGridRef = undefined;
+        try testing.expectEqual(Result.success, terminal_c.grid_ref(
+            terminal,
+            point.Point.cval(.{ .active = .{ .x = case.x, .y = 0 } }),
+            &ref,
+        ));
+        var userdata: [3]u8 = undefined;
+        var userdata_len: usize = 0;
+        try testing.expectEqual(
+            Result.success,
+            grid_ref_hyperlink_userdata(&ref, &userdata, userdata.len, &userdata_len),
+        );
+        try testing.expectEqualSlices(u8, &case.expected, userdata[0..userdata_len]);
+    }
+
+    const plain = try terminal.?.terminal.plainString(testing.allocator);
+    defer testing.allocator.free(plain);
+    try testing.expectEqualStrings("ab", plain);
+}
