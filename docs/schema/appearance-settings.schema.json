{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spaceterm.dev/schema/appearance-settings-v2.json",
  "title": "SpaceTerm appearance settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision",
    "preferences",
    "color_schemes"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "preferences": {
      "$ref": "#/$defs/preferences"
    },
    "color_schemes": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "color-scheme-definitions-v1.schema.json#/$defs/colorScheme"
      }
    }
  },
  "$defs": {
    "appearanceMode": {
      "enum": [
        "light",
        "dark",
        "auto"
      ]
    },
    "schemeSlots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "light",
        "dark"
      ],
      "properties": {
        "light": {
          "$ref": "color-scheme-definitions-v1.schema.json#/$defs/id"
        },
        "dark": {
          "$ref": "color-scheme-definitions-v1.schema.json#/$defs/id"
        }
      }
    },
    "terminalTypography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "base_size",
        "regular_weight",
        "bold_weight",
        "line_height",
        "italic"
      ],
      "properties": {
        "family": {
          "$ref": "#/$defs/terminalFamily"
        },
        "base_size": {
          "type": "number",
          "minimum": 8,
          "maximum": 32
        },
        "regular_weight": {
          "$ref": "#/$defs/weight"
        },
        "bold_weight": {
          "$ref": "#/$defs/weight"
        },
        "line_height": {
          "type": "number",
          "minimum": 1,
          "maximum": 2
        },
        "italic": {
          "type": "boolean"
        }
      }
    },
    "terminalFamily": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "const": "default_monospace"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "family"
          ],
          "properties": {
            "source": {
              "const": "named"
            },
            "family": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
            }
          }
        }
      ]
    },
    "weight": {
      "type": "integer",
      "minimum": 100,
      "maximum": 900
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "terminal",
        "window"
      ],
      "properties": {
        "mode": {
          "$ref": "#/$defs/appearanceMode"
        },
        "terminal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemes",
            "typography",
            "rendering",
            "overrides"
          ],
          "properties": {
            "schemes": {
              "$ref": "#/$defs/schemeSlots"
            },
            "typography": {
              "$ref": "#/$defs/terminalTypography"
            },
            "rendering": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "bold_as_bright"
              ],
              "properties": {
                "bold_as_bright": {
                  "type": "boolean"
                }
              }
            },
            "overrides": {
              "type": "object",
              "maxProperties": 128,
              "propertyNames": {
                "$ref": "color-scheme-definitions-v1.schema.json#/$defs/id"
              },
              "additionalProperties": {
                "$ref": "color-scheme-definitions-v1.schema.json#/$defs/terminalColors"
              }
            }
          }
        },
        "window": {
          "$ref": "#/$defs/window"
        }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transparency": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.35
        },
        "blur": {
          "type": "boolean",
          "default": true
        },
        "density": {
          "enum": [
            "compact",
            "comfortable"
          ]
        }
      },
      "required": [
        "density",
        "transparency",
        "blur"
      ]
    }
  }
}
