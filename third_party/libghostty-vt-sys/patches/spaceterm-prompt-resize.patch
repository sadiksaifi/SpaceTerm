+/// Remove a row in history and close the gap without leaving a blank row in
+/// history. The ordinary eraseRow shifts the suffix into a blank final row;
+/// dropping that row also moves the active boundary up by one.
+pub fn deleteHistoryRow(self: *PageList, pt: point.Point) !void {
+    const row_pin = self.pin(pt).?;
+    assert(!self.pinIsActive(row_pin));
+    try self.eraseRow(pt);
+
+    const last = self.pages.last.?;
+    const page = last.page();
+    self.invalidateNodeLayout(last);
+    page.size.rows -= 1;
+    self.total_rows -= 1;
+    if (page.size.rows == 0) self.erasePage(last);
+
+    self.viewport_pin_row_offset = null;
+    self.fixupViewport(0);
+    self.assertIntegrity();
