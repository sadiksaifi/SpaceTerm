#!/usr/bin/env python3
"""Require Conventional Commit subjects and a blank line before the body."""

import re
import subprocess
import sys
from pathlib import Path

message = subprocess.run(
    ["git", "stripspace", "--strip-comments"],
    input=Path(sys.argv[1]).read_text(), text=True, capture_output=True, check=True,
).stdout.splitlines()
if not message or not re.fullmatch(r"[a-z]+(?:\([^()\s]+\))?!?: \S.*", message[0]) or (len(message) > 1 and message[1]):
    sys.exit("Use a Conventional Commit: type(scope): description, with an optional ! before the colon. Separate the body with a blank line.")
