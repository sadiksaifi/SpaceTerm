<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>Label</key><string>@SERVER_IDENTIFIER@.@ACCOUNT_UID@</string>
    <key>ProgramArguments</key><array>
        <string>@LAUNCHER_PATH@</string>
        <string>--build</string><string>@BUILD@</string>
        <string>--account-uid</string><string>@ACCOUNT_UID@</string>
        <string>--registration-generation</string><string>@REGISTRATION_GENERATION@</string>
    </array>
    <key>UserName</key><string>root</string>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
    <key>ThrottleInterval</key><integer>20</integer>
    <!-- Deliberate Stopped admission exits zero. Locked storage uses the
         unprivileged wait/retry path, never a root sleeper or a new identity. -->
    <key>ExitTimeOut</key><integer>0</integer>
    <key>AbandonProcessGroup</key><false/>
    <key>WorkingDirectory</key><string>/</string>
    <key>StandardOutPath</key><string>/dev/null</string>
    <key>StandardErrorPath</key><string>/dev/null</string>
    <key>AssociatedBundleIdentifiers</key><array><string>@SERVER_IDENTIFIER@</string></array>
</dict></plist>
