+/**
+ * Clear the primary screen without passing bytes through the VT parser.
+ *
+ * The alternate screen is left unchanged. On the primary screen this clears
+ * the selection and, when requested, scrollback. If the cursor is at a shell
+ * prompt, the visible screen is cleared and the function returns true so the
+ * caller can send a form feed to request a prompt redraw. Otherwise only rows
+ * above the cursor are cleared and the function returns false.
+ *
+ * @param terminal The terminal handle (NULL returns false)
+ * @param history Whether to clear retained scrollback
+ * @return Whether the caller should send a form feed to redraw the prompt
+ *
+ * @ingroup terminal
+ */
+GHOSTTY_API bool ghostty_terminal_clear_screen(GhosttyTerminal terminal,
+                                               bool history);
