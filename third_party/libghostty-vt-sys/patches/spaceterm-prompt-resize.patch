+pub fn retirePendingPromptRedraw(self: *Screen) void {
+    if (self.pending_prompt_redraw) |pending| {
+        self.pages.untrackPin(pending.start);
+        self.pending_prompt_redraw = null;
+    }
+}
+
+pub fn retireLastPromptRedraw(self: *Screen) void {
+    if (self.pending_prompt_redraw) |pending| {
+        if (pending.redraw == .last) self.retirePendingPromptRedraw();
+    }
+}
+
+pub fn finishPendingPromptWithOutput(self: *Screen) void {
+    const pending = self.pending_prompt_redraw orelse return;
+    if (!pending.start.garbage) {
+        while (true) {
+            const start_y = self.pages.pointFromPin(.screen, pending.start.*).?.screen.y;
+            const cursor_y = self.pages.pointFromPin(.screen, self.cursor.page_pin.*).?.screen.y;
+            if (start_y >= cursor_y) break;
+
+            const page = pending.start.node.page();
+            const row = pending.start.rowAndCell().row;
+            for (page.getCells(row)) |cell| {
+                if (cell.hasText()) break;
+            } else {
+                const active_y = self.pages.pointFromPin(.screen, self.pages.getTopLeft(.active)).?.screen.y;
+                if (start_y < active_y) {
+                    self.pages.deleteHistoryRow(.{ .screen = .{ .y = start_y } }) catch break;
+                } else {
+                    self.pages.eraseRow(.{ .screen = .{ .y = start_y } }) catch break;
+                }
+                self.cursorReload();
+                continue;
+            }
+            break;
+        }
+    }
+    const cursor_page = self.cursor.page_pin.node.page();
+    for (cursor_page.getCells(self.cursor.page_row)) |cell| {
+        if (cell.hasText()) break;
+    } else {
+        self.cursorAbsolute(0, self.cursor.y);
+        const page = self.cursor.page_pin.node.page();
+        const row = self.cursor.page_row;
+        self.clearCells(page, row, page.getCells(row));
+        if (self.cursor.page_pin.up(1)) |previous| {
+            previous.rowAndCell().row.wrap = false;
+        }
+        row.wrap = false;
+        row.wrap_continuation = false;
+        self.cursor.pending_wrap = false;
+    }
+    self.retirePendingPromptRedraw();
+}
