diff --git a/src/terminal/c/color.zig b/src/terminal/c/color.zig
--- a/src/terminal/c/color.zig
+++ b/src/terminal/c/color.zig
@@ -17,4 +17,15 @@ pub const PaletteMask = extern struct {
         }
         return result;
     }
+
+    /// Convert from the Zig PaletteMask (std.StaticBitSet(256)).
+    pub fn fromZig(mask: color.PaletteMask) PaletteMask {
+        var result: PaletteMask = .{ .bits = .{ 0, 0, 0, 0 } };
+        for (0..256) |i| {
+            if (mask.isSet(i)) {
+                result.bits[i >> 6] |= @as(u64, 1) << @as(u6, @intCast(i & 63));
+            }
+        }
+        return result;
+    }
 };
