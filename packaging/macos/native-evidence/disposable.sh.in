#!/bin/sh
# Usage: /bin/sh runbook-disposable.sh <OpenSSH-destination>
# Send signed artifacts only. The disposable host needs passwordless sudo.
# Keep only the local agent socket for OpenSSH authentication. It is never sent
# to the host, controller, compiler, probe, or privileged admin environment.
/usr/bin/env -i PATH=/usr/bin:/bin:/usr/sbin:/sbin LC_ALL=C \
  SSH_AUTH_SOCK="${SSH_AUTH_SOCK-}" /bin/sh -s -- "$@" <<'SPACETERM_NATIVE_SSH'
set -eu
umask 077
test "$#" -eq 1 || { /usr/bin/printf 'failure=invalid-record\n' >&2; exit 1; }
HOST=$1
case "$HOST" in ''|-*|*[!A-Za-z0-9_.@-]*) /usr/bin/printf 'failure=invalid-record\n' >&2; exit 1 ;; esac
STAGE=@STAGE@
# The remote staging directory must be new. Never merge with downloaded material.
/usr/bin/ssh -o BatchMode=yes -o ForwardAgent=no -o ForwardX11=no -o ClearAllForwardings=yes -o PermitLocalCommand=no -- "$HOST" \
  '/usr/bin/env -i PATH=/usr/bin:/bin:/usr/sbin:/sbin LC_ALL=C /bin/mkdir -m 0700 /private/tmp/spaceterm-native-520-candidate' \
  >/dev/null 2>&1 || { /usr/bin/printf 'failure=unsafe-native-state\n' >&2; exit 1; }
/usr/bin/scp -q -o BatchMode=yes -o ForwardAgent=no -o ForwardX11=no -o ClearAllForwardings=yes -o PermitLocalCommand=no -r "$STAGE/." "$HOST:/private/tmp/spaceterm-native-520-candidate/" \
  >/dev/null 2>&1 || { /usr/bin/printf 'failure=io-unavailable\n' >&2; exit 1; }
# No -A, no forced GUI login, no permission grants, no PAM or Keychain changes.
# The native automated controller keeps interactive/hardware cases Unrun unless
# it independently observes their declared prerequisites and actual effects.
/usr/bin/ssh -o BatchMode=yes -o ForwardAgent=no -o ForwardX11=no -o ClearAllForwardings=yes -o PermitLocalCommand=no -- "$HOST" /usr/bin/env -i \
  PATH=/usr/bin:/bin:/usr/sbin:/sbin LC_ALL=C /bin/sh <<'SPACETERM_NATIVE_REMOTE'
@REMOTE_SEQUENCE@
SPACETERM_NATIVE_REMOTE
SPACETERM_NATIVE_SSH
