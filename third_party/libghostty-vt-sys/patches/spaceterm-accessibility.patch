index 000000000..172f23eac
--- /dev/null
+++ b/include/ghostty/vt/accessibility.h
@@ -0,0 +1,133 @@
+#ifndef GHOSTTY_VT_ACCESSIBILITY_H
+#define GHOSTTY_VT_ACCESSIBILITY_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include <ghostty/vt/types.h>
+
+typedef struct GhosttyAccessibilityState GhosttyAccessibilityState;
+
+typedef enum {
+  GHOSTTY_ACCESSIBILITY_SCREEN_PRIMARY = 0,
+  GHOSTTY_ACCESSIBILITY_SCREEN_ALTERNATE = 1,
+} GhosttyAccessibilityScreen;
+
+typedef enum {
+  GHOSTTY_ACCESSIBILITY_CELL_WIDE_NARROW = 0,
+  GHOSTTY_ACCESSIBILITY_CELL_WIDE_WIDE = 1,
+  GHOSTTY_ACCESSIBILITY_CELL_WIDE_SPACER_TAIL = 2,
+  GHOSTTY_ACCESSIBILITY_CELL_WIDE_SPACER_HEAD = 3,
+} GhosttyAccessibilityCellWide;
+
+typedef struct {
+  GhosttyAccessibilityScreen screen;
+  uint64_t screen_generation;
+  uint64_t node_serial;
+  uint16_t page_row;
+} GhosttyAccessibilityRowId;
+
+typedef struct {
+  GhosttyAccessibilityRowId row;
+  uint64_t row_revision;
+  uint16_t column;
+} GhosttyAccessibilityCellRef;
+
+typedef struct {
+  size_t size;
+  size_t max_cells;
+  size_t max_rows;
+} GhosttyAccessibilityUpdateOptions;
+
+typedef struct {
+  size_t size;
+  uint64_t revision;
+  GhosttyAccessibilityScreen screen;
+  uint64_t screen_generation;
+  bool complete;
+  bool more;
+  bool topology_changed;
+  uint64_t topology_epoch;
+  bool topology_complete;
+  size_t visible_start;
+  size_t visible_len;
+  bool has_cursor;
+  GhosttyAccessibilityCellRef cursor;
+  bool has_selection;
+  GhosttyAccessibilityCellRef selection_start;
+  GhosttyAccessibilityCellRef selection_end;
+  bool selection_rectangle;
+} GhosttyAccessibilitySnapshot;
+
+typedef struct {
+  GhosttyAccessibilityRowId id;
+  uint64_t revision;
+  bool soft_wrapped;
+} GhosttyAccessibilityRow;
+
+typedef struct {
+  uint16_t column;
+  GhosttyAccessibilityCellWide wide;
+  uint32_t codepoint;
+  const uint32_t* extra_codepoints;
+  size_t extra_codepoints_len;
+} GhosttyAccessibilityCell;
+
+typedef bool (*GhosttyAccessibilityTopologyCallback)(
+    void* userdata,
+    const GhosttyAccessibilityRowId* row);
+typedef bool (*GhosttyAccessibilityRowCallback)(
+    void* userdata,
+    const GhosttyAccessibilityRow* row);
+typedef bool (*GhosttyAccessibilityCellCallback)(
+    void* userdata,
+    const GhosttyAccessibilityCell* cell);
+
+/**
+ * Create persistent incremental accessibility state.
+ *
+ * The state is independent of a terminal, is not thread-safe, and must be
+ * freed with ghostty_accessibility_state_free.
+ */
+GHOSTTY_API GhosttyResult ghostty_accessibility_state_new(
+    GhosttyAccessibilityState** out_state);
+GHOSTTY_API void ghostty_accessibility_state_free(
+    GhosttyAccessibilityState* state);
+
+/**
+ * Observe terminal dirty state and extract a bounded semantic delta.
+ *
+ * Call this before Ghostty render-state update clears page/row dirty bits.
+ * max_cells and max_rows are hard-clamped to 16384 and 256 respectively.
+ * Compressed pages are decoded into temporary storage and remain compressed.
+ * Topology callbacks are chunked within max_rows. topology_epoch identifies
+ * one replacement topology and topology_complete marks its final chunk; row
+ * extraction begins only on a later call after that topology is complete.
+ * Callback pointers are borrowed only for the duration of this call.
+ */
+GHOSTTY_API GhosttyResult ghostty_accessibility_state_update(
+    GhosttyAccessibilityState* state,
+    GhosttyTerminal terminal,
+    const GhosttyAccessibilityUpdateOptions* options,
+    void* userdata,
+    GhosttyAccessibilityTopologyCallback topology_callback,
+    GhosttyAccessibilityRowCallback row_callback,
+    GhosttyAccessibilityCellCallback cell_callback,
+    GhosttyAccessibilitySnapshot* out_snapshot);
+
+/**
+ * Replace or clear the active terminal selection.
+ *
+ * Non-NULL endpoints must name the active screen generation and exact current
+ * row revisions from a complete snapshot. A stale request succeeds with
+ * out_changed=false and does not mutate the terminal.
+ */
+GHOSTTY_API GhosttyResult ghostty_accessibility_state_set_selection(
+    GhosttyAccessibilityState* state,
+    GhosttyTerminal terminal,
+    const GhosttyAccessibilityCellRef* start,
+    const GhosttyAccessibilityCellRef* end,
+    bool* out_changed);
+
+#endif /* GHOSTTY_VT_ACCESSIBILITY_H */
