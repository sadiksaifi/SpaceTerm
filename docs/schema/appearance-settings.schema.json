{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spaceterm.dev/schema/appearance-settings-v1.json",
  "title": "SpaceTerm appearance settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision",
    "preferences",
    "custom_schemes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "preferences": {
      "$ref": "#/$defs/preferences"
    },
    "custom_schemes": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/customScheme"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*([._-][a-z0-9]+)*$"
    },
    "color": {
      "type": "string",
      "pattern": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$"
    },
    "appearance": {
      "enum": [
        "light",
        "dark"
      ]
    },
    "selection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy",
            "id",
            "appearance"
          ],
          "properties": {
            "policy": {
              "const": "fixed"
            },
            "id": {
              "$ref": "#/$defs/id"
            },
            "appearance": {
              "$ref": "#/$defs/appearance"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy",
            "light",
            "dark"
          ],
          "properties": {
            "policy": {
              "const": "system"
            },
            "light": {
              "$ref": "#/$defs/id"
            },
            "dark": {
              "$ref": "#/$defs/id"
            }
          }
        }
      ]
    },
    "chromeColors": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "background",
          "panel_background",
          "elevated_surface_background",
          "title_bar_background",
          "title_bar_inactive_background",
          "tab_active_background",
          "tab_inactive_background",
          "text",
          "text_secondary",
          "text_muted",
          "text_placeholder",
          "text_disabled",
          "text_accent",
          "link_text",
          "link_text_hover",
          "link_text_pressed",
          "link_text_disabled",
          "icon",
          "icon_muted",
          "icon_disabled",
          "border",
          "border_variant",
          "border_focused",
          "border_selected",
          "border_disabled",
          "border_transparent",
          "element_background",
          "element_hover",
          "element_active",
          "element_selected",
          "element_disabled",
          "element_foreground",
          "element_hover_foreground",
          "element_active_foreground",
          "element_disabled_foreground",
          "ghost_element_background",
          "ghost_element_hover",
          "ghost_element_active",
          "ghost_element_selected",
          "ghost_element_disabled",
          "ghost_element_foreground",
          "ghost_element_hover_foreground",
          "ghost_element_active_foreground",
          "ghost_element_selected_foreground",
          "ghost_element_disabled_foreground",
          "sidebar_focus",
          "info",
          "info_background",
          "success",
          "warning",
          "warning_background",
          "warning_border",
          "error",
          "error_background",
          "error_border",
          "input_text",
          "input_placeholder",
          "input_disabled_text",
          "input_caret",
          "input_selection_background",
          "input_selection_foreground",
          "input_background",
          "input_disabled_background",
          "input_border",
          "input_focused_border",
          "input_invalid_border",
          "modal_scrim",
          "scrollbar_track",
          "scrollbar_track_border",
          "scrollbar_thumb_background",
          "scrollbar_thumb_border",
          "scrollbar_thumb_hover_background",
          "resize_idle",
          "resize_focused",
          "resize_hovered",
          "resize_dragged",
          "resize_disabled",
          "shadow",
          "primary_background",
          "primary_foreground",
          "primary_icon",
          "primary_border",
          "primary_hover_background",
          "primary_hover_foreground",
          "primary_hover_icon",
          "primary_hover_border",
          "primary_pressed_background",
          "primary_pressed_foreground",
          "primary_pressed_icon",
          "primary_pressed_border",
          "primary_disabled_background",
          "primary_disabled_foreground",
          "primary_disabled_icon",
          "primary_disabled_border",
          "destructive_background",
          "destructive_foreground",
          "destructive_icon",
          "destructive_border",
          "destructive_hover_background",
          "destructive_hover_foreground",
          "destructive_hover_icon",
          "destructive_hover_border",
          "destructive_pressed_background",
          "destructive_pressed_foreground",
          "destructive_pressed_icon",
          "destructive_pressed_border",
          "destructive_disabled_background",
          "destructive_disabled_foreground",
          "destructive_disabled_icon",
          "destructive_disabled_border",
          "selection_background",
          "selection_foreground",
          "selection_icon",
          "selection_border",
          "selection_hover_background",
          "selection_hover_foreground",
          "selection_hover_icon",
          "selection_hover_border",
          "selection_pressed_background",
          "selection_pressed_foreground",
          "selection_pressed_icon",
          "selection_pressed_border",
          "selection_disabled_background",
          "selection_disabled_foreground",
          "selection_disabled_icon",
          "selection_disabled_border",
          "toggle_off_background",
          "toggle_off_mark",
          "toggle_off_border",
          "toggle_off_label",
          "toggle_off_hover_background",
          "toggle_off_hover_mark",
          "toggle_off_hover_border",
          "toggle_off_hover_label",
          "toggle_off_pressed_background",
          "toggle_off_pressed_mark",
          "toggle_off_pressed_border",
          "toggle_off_pressed_label",
          "toggle_off_disabled_background",
          "toggle_off_disabled_mark",
          "toggle_off_disabled_border",
          "toggle_off_disabled_label",
          "toggle_on_background",
          "toggle_on_mark",
          "toggle_on_border",
          "toggle_on_label",
          "toggle_on_hover_background",
          "toggle_on_hover_mark",
          "toggle_on_hover_border",
          "toggle_on_hover_label",
          "toggle_on_pressed_background",
          "toggle_on_pressed_mark",
          "toggle_on_pressed_border",
          "toggle_on_pressed_label",
          "toggle_on_disabled_background",
          "toggle_on_disabled_mark",
          "toggle_on_disabled_border",
          "toggle_on_disabled_label",
          "row_background",
          "row_foreground",
          "row_secondary",
          "row_icon",
          "row_match",
          "row_border",
          "row_hover_background",
          "row_hover_foreground",
          "row_hover_secondary",
          "row_hover_icon",
          "row_hover_match",
          "row_hover_border",
          "row_selected_background",
          "row_selected_foreground",
          "row_selected_secondary",
          "row_selected_icon",
          "row_selected_match",
          "row_selected_border",
          "row_selected_hover_background",
          "row_selected_hover_foreground",
          "row_selected_hover_secondary",
          "row_selected_hover_icon",
          "row_selected_hover_match",
          "row_selected_hover_border",
          "element_icon",
          "element_hover_icon",
          "element_active_icon",
          "element_disabled_icon",
          "ghost_element_icon",
          "ghost_element_hover_icon",
          "ghost_element_active_icon",
          "ghost_element_disabled_icon",
          "input_disabled_border",
          "badge_background",
          "badge_foreground",
          "preview_background",
          "preview_foreground",
          "tab_active_foreground",
          "tab_inactive_foreground",
          "tab_inactive_selected_background",
          "tab_inactive_selected_foreground",
          "scrollbar_thumb_active_background",
          "success_background",
          "success_border",
          "info_border",
          "element_border",
          "element_hover_border",
          "element_active_border",
          "element_disabled_border",
          "ghost_element_border",
          "ghost_element_hover_border",
          "ghost_element_active_border",
          "ghost_element_disabled_border",
          "outline_border",
          "outline_hover_border",
          "outline_pressed_border",
          "outline_disabled_border",
          "tab_hover_background",
          "tab_hover_foreground",
          "tab_hover_icon",
          "tab_active_icon",
          "tab_inactive_icon",
          "tab_inactive_selected_icon",
          "tab_active_border",
          "tab_active_hover_background",
          "tab_active_hover_foreground",
          "tab_active_hover_icon",
          "tab_inactive_selected_border"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/color"
      },
      "properties": {
        "border_transparent": {
          "type": "string",
          "pattern": "^#(?:[0-9A-Fa-f]{3}0|[0-9A-Fa-f]{6}00)$"
        }
      }
    },
    "terminalColors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "foreground": {
          "$ref": "#/$defs/opaqueColor"
        },
        "background": {
          "$ref": "#/$defs/opaqueColor"
        },
        "normal": {
          "$ref": "#/$defs/palette"
        },
        "bright": {
          "$ref": "#/$defs/palette"
        },
        "dim": {
          "$ref": "#/$defs/palette"
        },
        "bright_foreground": {
          "$ref": "#/$defs/opaqueColor"
        },
        "dim_foreground": {
          "$ref": "#/$defs/opaqueColor"
        },
        "cursor": {
          "$ref": "#/$defs/opaqueColor"
        },
        "cursor_text": {
          "$ref": "#/$defs/nullableOpaqueColor"
        },
        "selection_background": {
          "$ref": "#/$defs/color"
        },
        "selection_foreground": {
          "$ref": "#/$defs/nullableOpaqueColor"
        },
        "find_match_background": {
          "$ref": "#/$defs/color"
        },
        "find_match_foreground": {
          "$ref": "#/$defs/nullableOpaqueColor"
        },
        "find_active_match_background": {
          "$ref": "#/$defs/color"
        },
        "find_active_match_foreground": {
          "$ref": "#/$defs/nullableOpaqueColor"
        },
        "hyperlink": {
          "$ref": "#/$defs/color"
        },
        "visual_bell": {
          "$ref": "#/$defs/color"
        }
      }
    },
    "nullableColor": {
      "oneOf": [
        {
          "$ref": "#/$defs/color"
        },
        {
          "type": "null"
        }
      ]
    },
    "palette": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/opaqueColor"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "author": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "license": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "description": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "origin": {
          "$ref": "#/$defs/schemeOrigin"
        }
      }
    },
    "customScheme": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "name",
            "appearance",
            "colors"
          ],
          "properties": {
            "kind": {
              "const": "chrome"
            },
            "id": {
              "$ref": "#/$defs/id"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
            },
            "appearance": {
              "$ref": "#/$defs/appearance"
            },
            "author": {
              "type": "string",
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
            },
            "license": {
              "type": "string",
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
            },
            "description": {
              "type": "string",
              "maxLength": 1024,
              "minLength": 1,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
            },
            "colors": {
              "$ref": "#/$defs/chromeColors"
            },
            "origin": {
              "$ref": "#/$defs/schemeOrigin"
            },
            "window_background": {
              "$ref": "#/$defs/windowBackground"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "name",
            "appearance",
            "colors"
          ],
          "properties": {
            "kind": {
              "const": "terminal"
            },
            "id": {
              "$ref": "#/$defs/id"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
            },
            "appearance": {
              "$ref": "#/$defs/appearance"
            },
            "author": {
              "type": "string",
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
            },
            "license": {
              "type": "string",
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
            },
            "description": {
              "type": "string",
              "maxLength": 1024,
              "minLength": 1,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
            },
            "colors": {
              "$ref": "#/$defs/terminalColors"
            },
            "origin": {
              "$ref": "#/$defs/schemeOrigin"
            }
          }
        }
      ]
    },
    "chromeTypography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "base_size",
        "regular_weight",
        "emphasis_weight",
        "heading_weight"
      ],
      "properties": {
        "family": {
          "$ref": "#/$defs/chromeFamily"
        },
        "base_size": {
          "type": "number",
          "minimum": 10,
          "maximum": 24
        },
        "regular_weight": {
          "$ref": "#/$defs/weight"
        },
        "emphasis_weight": {
          "$ref": "#/$defs/weight"
        },
        "heading_weight": {
          "$ref": "#/$defs/weight"
        }
      }
    },
    "terminalTypography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "base_size",
        "regular_weight",
        "bold_weight",
        "line_height",
        "italic"
      ],
      "properties": {
        "family": {
          "$ref": "#/$defs/terminalFamily"
        },
        "base_size": {
          "type": "number",
          "minimum": 8,
          "maximum": 32
        },
        "regular_weight": {
          "$ref": "#/$defs/weight"
        },
        "bold_weight": {
          "$ref": "#/$defs/weight"
        },
        "line_height": {
          "type": "number",
          "minimum": 1,
          "maximum": 2
        },
        "italic": {
          "type": "boolean"
        }
      }
    },
    "chromeFamily": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "const": "system_ui"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "family"
          ],
          "properties": {
            "source": {
              "const": "named"
            },
            "family": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      ]
    },
    "terminalFamily": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "const": "default_monospace"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "family"
          ],
          "properties": {
            "source": {
              "const": "named"
            },
            "family": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      ]
    },
    "weight": {
      "type": "integer",
      "minimum": 100,
      "maximum": 900
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chrome",
        "terminal"
      ],
      "properties": {
        "chrome": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scheme",
            "typography",
            "density",
            "overrides"
          ],
          "properties": {
            "scheme": {
              "$ref": "#/$defs/selection"
            },
            "typography": {
              "$ref": "#/$defs/chromeTypography"
            },
            "density": {
              "enum": [
                "compact",
                "comfortable"
              ]
            },
            "overrides": {
              "type": "object",
              "maxProperties": 128,
              "propertyNames": {
                "$ref": "#/$defs/id"
              },
              "additionalProperties": {
                "$ref": "#/$defs/chromeColors"
              }
            }
          }
        },
        "terminal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scheme",
            "typography",
            "rendering",
            "overrides"
          ],
          "properties": {
            "scheme": {
              "$ref": "#/$defs/selection"
            },
            "typography": {
              "$ref": "#/$defs/terminalTypography"
            },
            "rendering": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "bold_as_bright"
              ],
              "properties": {
                "bold_as_bright": {
                  "type": "boolean"
                }
              }
            },
            "overrides": {
              "type": "object",
              "maxProperties": 128,
              "propertyNames": {
                "$ref": "#/$defs/id"
              },
              "additionalProperties": {
                "$ref": "#/$defs/terminalColors"
              }
            }
          }
        }
      }
    },
    "opaqueColor": {
      "type": "string",
      "pattern": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{3}[fF]|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{6}[fF]{2})$"
    },
    "nullableOpaqueColor": {
      "oneOf": [
        {
          "$ref": "#/$defs/opaqueColor"
        },
        {
          "type": "null"
        }
      ]
    },
    "windowBackground": {
      "enum": [
        "opaque",
        "transparent",
        "blurred"
      ]
    },
    "schemeOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "family",
        "theme",
        "fingerprint"
      ],
      "properties": {
        "format": {
          "const": "zed"
        },
        "package_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "theme": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      }
    }
  }
}
