+test "storage: RGBA conversion admits growth before changing the image" {
+    const testing = std.testing;
+    const io = testing.io;
+    const alloc = testing.allocator;
+    const cases = [_]struct {
+        format: command.Transmission.Format,
+        data: []const u8,
+        rgba: []const u8,
+    }{
+        .{ .format = .rgb, .data = &.{ 1, 2, 3 }, .rgba = &.{ 1, 2, 3, 255 } },
+        .{ .format = .gray_alpha, .data = &.{ 1, 2 }, .rgba = &.{ 1, 1, 1, 2 } },
+        .{ .format = .gray, .data = &.{1}, .rgba = &.{ 1, 1, 1, 255 } },
+    };
+    for (cases) |case| {
+        var t = try terminal.Terminal.init(io, alloc, .{ .rows = 3, .cols = 3 });
+        defer t.deinit(alloc);
+        const s = &t.screens.active.kitty_images;
+        s.setLimit(io, alloc, t.screens.active, case.data.len);
+        try s.addImage(io, alloc, t.screens.active, .{
+            .id = 1,
+            .width = 1,
+            .height = 1,
+            .format = case.format,
+            .data = .{ .complete = try alloc.dupe(u8, case.data) },
+        });
+        const generation = s.generation;
+        var failing = testing.FailingAllocator.init(alloc, .{ .fail_index = 0 });
+        try testing.expectError(error.OutOfMemory, s.convertImageToRgba(
+            io,
+            failing.allocator(),
+            t.screens.active,
+            s.images.getPtr(1).?,
+        ));
+        try testing.expect(!failing.has_induced_failure);
+        try testing.expectEqual(generation, s.generation);
+        try testing.expectEqual(case.data.len, s.total_bytes);
+        try testing.expectEqual(case.format, s.images.get(1).?.format);
+        try testing.expectEqualSlices(u8, case.data, s.images.get(1).?.data.bytes().?);
+
+        s.setLimit(io, alloc, t.screens.active, 4);
+        const img = try s.convertImageToRgba(io, alloc, t.screens.active, s.images.getPtr(1).?);
+        try testing.expectEqual(@as(usize, 4), s.total_bytes);
+        try testing.expectEqualSlices(u8, case.rgba, img.data.bytes().?);
+        try testing.expect(img.generation > generation);
+        try testing.expectEqual(generation, img.transmission_generation);
+        const converted_generation = img.generation;
+        _ = try s.convertImageToRgba(io, alloc, t.screens.active, img);
+        try testing.expectEqual(@as(usize, 4), s.total_bytes);
+        try testing.expectEqual(converted_generation, img.generation);
+    }
+}
