diff --git a/src/terminal/c/kitty_graphics.zig b/src/terminal/c/kitty_graphics.zig
index 13a675ccc..5b640dc46 100644
--- a/src/terminal/c/kitty_graphics.zig
+++ b/src/terminal/c/kitty_graphics.zig
@@ -546,6 +546,119 @@ pub const PlacementRenderInfo = extern struct {
     source_height: u32 = 0,
 };
 
+/// A fully resolved placement ready for a renderer. Unlike the raw placement
+/// iterator, this includes occurrences produced by Unicode placeholders.
+pub const ResolvedPlacement = extern struct {
+    size: usize = @sizeOf(ResolvedPlacement),
+    image_id: u32 = 0,
+    placement_id: u32 = 0,
+    z: i32 = 0,
+    viewport_col: i32 = 0,
+    viewport_row: i32 = 0,
+    cell_offset_x: u32 = 0,
+    cell_offset_y: u32 = 0,
+    source_x: u32 = 0,
+    source_y: u32 = 0,
+    source_width: u32 = 0,
+    source_height: u32 = 0,
+    dest_width: u32 = 0,
+    dest_height: u32 = 0,
+    is_virtual: bool = false,
+};
+
+pub const ResolvedPlacementCallback = *const fn (
+    userdata: ?*anyopaque,
+    placement: *const ResolvedPlacement,
+) callconv(lib.calling_conv) bool;
+
+/// Visit all visible placements after resolving their viewport geometry.
+/// The callback and placement pointer are valid only for this call.
+pub fn resolved_placements(
+    terminal_: terminal_c.Terminal,
+    userdata: ?*anyopaque,
+    callback_: ?ResolvedPlacementCallback,
+) callconv(lib.calling_conv) Result {
+    if (comptime !build_options.kitty_graphics) return .no_value;
+
+    const wrapper = terminal_ orelse return .invalid_value;
+    const callback = callback_ orelse return .invalid_value;
+    const t = wrapper.terminal;
+    const storage = &t.screens.active.kitty_images;
+    const top = t.screens.active.pages.getTopLeft(.viewport);
+    const bot = t.screens.active.pages.getBottomRight(.viewport) orelse return .success;
+    const top_y = t.screens.active.pages.pointFromPin(.screen, top).?.screen.y;
+    const bot_y = t.screens.active.pages.pointFromPin(.screen, bot).?.screen.y;
+
+    var has_virtual = false;
+    var it = storage.placements.iterator();
+    while (it.next()) |entry| {
+        const p = entry.value_ptr;
+        switch (p.location) {
+            .virtual => {
+                has_virtual = true;
+                continue;
+            },
+            .pin => {},
+        }
+
+        const image = storage.imageById(entry.key_ptr.image_id) orelse continue;
+        const rect = p.rect(image, t) orelse continue;
+        const image_top_y = t.screens.active.pages.pointFromPin(.screen, rect.top_left).?.screen.y;
+        const image_bot_y = t.screens.active.pages.pointFromPin(.screen, rect.bottom_right).?.screen.y;
+        if (image_top_y > bot_y or image_bot_y < top_y) continue;
+
+        const dest = p.pixelSize(image, t);
+        if (dest.width == 0 or dest.height == 0) continue;
+        const source_x = @min(image.width, p.source_x);
+        const source_y = @min(image.height, p.source_y);
+        const resolved: ResolvedPlacement = .{
+            .image_id = image.id,
+            .placement_id = entry.key_ptr.placement_id.id,
+            .z = p.z,
+            .viewport_col = @intCast(rect.top_left.x),
+            .viewport_row = @as(i32, @intCast(image_top_y)) - @as(i32, @intCast(top_y)),
+            .cell_offset_x = p.x_offset,
+            .cell_offset_y = p.y_offset,
+            .source_x = source_x,
+            .source_y = source_y,
+            .source_width = if (p.source_width > 0) @min(image.width - source_x, p.source_width) else image.width - source_x,
+            .source_height = if (p.source_height > 0) @min(image.height - source_y, p.source_height) else image.height - source_y,
+            .dest_width = dest.width,
+            .dest_height = dest.height,
+        };
+        if (!callback(userdata, &resolved)) return .success;
+    }
+
+    if (has_virtual) {
+        var virtual_it = @import("../kitty/graphics_unicode.zig").placementIterator(top, bot);
+        while (virtual_it.next()) |p| {
+            const image = storage.imageById(p.image_id) orelse continue;
+            const rp = p.renderPlacement(storage, &image, t.width_px / t.cols, t.height_px / t.rows) catch continue;
+            if (rp.dest_width == 0 or rp.dest_height == 0) continue;
+            const viewport = t.screens.active.pages.pointFromPin(.viewport, rp.top_left) orelse continue;
+            const resolved: ResolvedPlacement = .{
+                .image_id = image.id,
+                .placement_id = p.placement_id,
+                .z = -1,
+                .viewport_col = @intCast(rp.top_left.x),
+                .viewport_row = @intCast(viewport.viewport.y),
+                .cell_offset_x = rp.offset_x,
+                .cell_offset_y = rp.offset_y,
+                .source_x = rp.source_x,
+                .source_y = rp.source_y,
+                .source_width = rp.source_width,
+                .source_height = rp.source_height,
+                .dest_width = rp.dest_width,
+                .dest_height = rp.dest_height,
+                .is_virtual = true,
+            };
+            if (!callback(userdata, &resolved)) return .success;
+        }
+    }
+
+    return .success;
+}
