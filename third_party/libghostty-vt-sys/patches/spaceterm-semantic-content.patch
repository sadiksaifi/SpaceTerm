+#ifndef GHOSTTY_VT_CONTENT_H
+#define GHOSTTY_VT_CONTENT_H
+#include <ghostty/vt/accessibility.h>
+#include <ghostty/vt/style.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+/* All callback data is borrowed until callback return. Copy before returning.
+ * Reads preserve compressed storage. Offsets refer to document order, not the
+ * viewport. Sized inputs reject a shorter layout. No selection is installed. */
+typedef struct GhosttyContentState GhosttyContentState;
+typedef struct GhosttyContentScan GhosttyContentScan;
+typedef struct { size_t size; uint64_t source_revision, topology_revision; GhosttyAccessibilityScreen screen; uint64_t screen_generation; uint32_t total_rows, active_start; uint16_t columns; bool synchronized; GhosttyAccessibilityRowId cursor; uint16_t cursor_column; int cursor_shape; } GhosttyContentSnapshot;
+typedef struct { size_t size; uint32_t row; uint16_t column; uint32_t end_row; uint16_t max_rows; uint32_t max_cells; size_t max_bytes; bool seek, seek_after; GhosttyAccessibilityRowId seek_row; } GhosttyContentOptions;
+typedef struct { size_t size; GhosttyAccessibilityRowId id; uint64_t revision; uint32_t document_row; uint16_t columns, start_column, emitted_columns; bool soft_wrapped; } GhosttyContentRow;
+typedef struct { size_t size; uint32_t codepoint; const uint32_t *extra_codepoints; size_t extra_codepoints_len; GhosttyAccessibilityCellWide wide; int semantic; bool has_text; GhosttyStyle style; const uint8_t *hyperlink; size_t hyperlink_len; } GhosttyContentCell;
+typedef struct { size_t size; uint32_t next_row; uint16_t next_column; uint32_t inspected_cells, emitted_cells; uint16_t emitted_rows; size_t accounted_bytes; bool complete; } GhosttyContentProgress;
+typedef bool (*GhosttyContentRowCallback)(void *, const GhosttyContentRow *);
+typedef bool (*GhosttyContentCellCallback)(void *, const GhosttyContentCell *);
+GHOSTTY_API GhosttyResult ghostty_content_state_new(GhosttyContentState **);
+GHOSTTY_API void ghostty_content_state_free(GhosttyContentState *);
+GHOSTTY_API GhosttyResult ghostty_content_state_capture(GhosttyContentState *, GhosttyTerminal, GhosttyContentSnapshot *);
+GHOSTTY_API GhosttyResult ghostty_content_read_page(GhosttyContentState *, GhosttyTerminal, const GhosttyContentOptions *, void *, GhosttyContentRowCallback, GhosttyContentCellCallback, GhosttyContentProgress *);
+GHOSTTY_API GhosttyResult ghostty_content_read_topology(GhosttyContentState *, GhosttyTerminal, const GhosttyContentOptions *, void *, GhosttyContentRowCallback, GhosttyContentProgress *);
+/* Copy/Find cursors retain a revision-exact semantic scan, not terminal state.
+ * The embedding performs incremental formatting/matching on returned cells. */
+GHOSTTY_API GhosttyResult ghostty_content_copy_begin(GhosttyContentState *, GhosttyTerminal, const GhosttyContentOptions *, GhosttyContentScan **);
+GHOSTTY_API GhosttyResult ghostty_content_find_begin(GhosttyContentState *, GhosttyTerminal, const GhosttyContentOptions *, GhosttyContentScan **);
+GHOSTTY_API GhosttyResult ghostty_content_copy_step(GhosttyContentState *, GhosttyTerminal, GhosttyContentScan *, const GhosttyContentOptions *, void *, GhosttyContentRowCallback, GhosttyContentCellCallback, GhosttyContentProgress *);
+GHOSTTY_API GhosttyResult ghostty_content_find_step(GhosttyContentState *, GhosttyTerminal, GhosttyContentScan *, const GhosttyContentOptions *, void *, GhosttyContentRowCallback, GhosttyContentCellCallback, GhosttyContentProgress *);
+GHOSTTY_API void ghostty_content_copy_free(GhosttyContentState *, GhosttyContentScan *);
+GHOSTTY_API void ghostty_content_find_free(GhosttyContentState *, GhosttyContentScan *);
+typedef struct { size_t size; uint32_t image_id; uint64_t placement_id; uint32_t document_row; int32_t column; uint32_t columns, rows, offset_x, offset_y, source_x, source_y, source_width, source_height, dest_width, dest_height; bool is_virtual; int32_t z; } GhosttyContentPlacement;
+typedef bool (*GhosttyContentPlacementCallback)(void *, const GhosttyContentPlacement *);
+GHOSTTY_API GhosttyResult ghostty_content_prepare_placements(GhosttyContentState *, GhosttyTerminal, GhosttyContentProgress *);
+GHOSTTY_API GhosttyResult ghostty_content_read_placements(GhosttyContentState *, GhosttyTerminal, const GhosttyContentOptions *, void *, GhosttyContentPlacementCallback);
+#ifdef __cplusplus
+}
+#endif
+#endif
