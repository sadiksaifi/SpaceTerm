{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spaceterm.dev/schema/appearance-settings-v3.json",
  "title": "SpaceTerm appearance settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision",
    "preferences",
    "terminal_themes"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "preferences": {
      "$ref": "#/$defs/preferences"
    },
    "terminal_themes": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/terminalTheme"
      }
    }
  },
  "$defs": {
    "appearanceMode": {
      "enum": [
        "light",
        "dark",
        "auto"
      ]
    },
    "terminalTypography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "base_size",
        "regular_weight",
        "bold_weight",
        "line_height",
        "italic"
      ],
      "properties": {
        "family": {
          "$ref": "#/$defs/terminalFamily"
        },
        "base_size": {
          "type": "number",
          "minimum": 8,
          "maximum": 32
        },
        "regular_weight": {
          "$ref": "#/$defs/weight"
        },
        "bold_weight": {
          "$ref": "#/$defs/weight"
        },
        "line_height": {
          "type": "number",
          "minimum": 1,
          "maximum": 2
        },
        "italic": {
          "type": "boolean"
        }
      }
    },
    "terminalFamily": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "const": "default_monospace"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "family"
          ],
          "properties": {
            "source": {
              "const": "named"
            },
            "family": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
            }
          }
        }
      ]
    },
    "weight": {
      "type": "integer",
      "minimum": 100,
      "maximum": 900
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "terminal",
        "window"
      ],
      "properties": {
        "mode": {
          "$ref": "#/$defs/appearanceMode"
        },
        "terminal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "themes",
            "typography",
            "rendering",
            "overrides"
          ],
          "properties": {
            "themes": {
              "$ref": "#/$defs/themeSlots"
            },
            "typography": {
              "$ref": "#/$defs/terminalTypography"
            },
            "rendering": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "bold_as_bright"
              ],
              "properties": {
                "bold_as_bright": {
                  "type": "boolean"
                }
              }
            },
            "overrides": {
              "type": "object",
              "maxProperties": 128,
              "propertyNames": {
                "$ref": "#/$defs/themeId"
              },
              "additionalProperties": {
                "$ref": "#/$defs/terminalColors"
              }
            }
          }
        },
        "window": {
          "$ref": "#/$defs/window"
        }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transparency": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.35
        },
        "blur": {
          "type": "boolean",
          "default": true
        },
        "density": {
          "enum": [
            "compact",
            "comfortable"
          ]
        }
      },
      "required": [
        "density",
        "transparency",
        "blur"
      ]
    },
    "themeSlots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "light",
        "dark"
      ],
      "properties": {
        "light": {
          "$ref": "#/$defs/themeId"
        },
        "dark": {
          "$ref": "#/$defs/themeId"
        }
      }
    },
    "themeId": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*([._-][a-z0-9]+)*$"
    },
    "importedThemeId": {
      "allOf": [
        {
          "$ref": "#/$defs/themeId"
        },
        {
          "not": {
            "pattern": "^builtin\\."
          }
        }
      ]
    },
    "color": {
      "type": "string",
      "pattern": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$"
    },
    "appearance": {
      "enum": [
        "light",
        "dark"
      ]
    },
    "terminalColors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "foreground": {
          "$ref": "#/$defs/opaqueColor"
        },
        "background": {
          "$ref": "#/$defs/opaqueColor"
        },
        "normal": {
          "$ref": "#/$defs/palette"
        },
        "bright": {
          "$ref": "#/$defs/palette"
        },
        "dim": {
          "$ref": "#/$defs/palette"
        },
        "bright_foreground": {
          "$ref": "#/$defs/opaqueColor"
        },
        "dim_foreground": {
          "$ref": "#/$defs/opaqueColor"
        },
        "cursor": {
          "$ref": "#/$defs/opaqueColor"
        },
        "cursor_text": {
          "$ref": "#/$defs/nullableOpaqueColor"
        },
        "selection_background": {
          "$ref": "#/$defs/color"
        },
        "selection_foreground": {
          "$ref": "#/$defs/nullableOpaqueColor"
        },
        "find_match_background": {
          "$ref": "#/$defs/color"
        },
        "find_match_foreground": {
          "$ref": "#/$defs/nullableOpaqueColor"
        },
        "find_active_match_background": {
          "$ref": "#/$defs/color"
        },
        "find_active_match_foreground": {
          "$ref": "#/$defs/nullableOpaqueColor"
        },
        "hyperlink": {
          "$ref": "#/$defs/color"
        },
        "visual_bell": {
          "$ref": "#/$defs/color"
        }
      }
    },
    "palette": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/opaqueColor"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "opaqueColor": {
      "type": "string",
      "pattern": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{3}[fF]|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{6}[fF]{2})$"
    },
    "nullableOpaqueColor": {
      "oneOf": [
        {
          "$ref": "#/$defs/opaqueColor"
        },
        {
          "type": "null"
        }
      ]
    },
    "themeOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "family",
        "theme",
        "fingerprint"
      ],
      "properties": {
        "format": {
          "const": "zed"
        },
        "package_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "package_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "theme": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      }
    },
    "terminalTheme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "appearance",
        "colors"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/importedThemeId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "appearance": {
          "$ref": "#/$defs/appearance"
        },
        "author": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "license": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "description": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "colors": {
          "$ref": "#/$defs/terminalColors"
        },
        "origin": {
          "$ref": "#/$defs/themeOrigin"
        }
      }
    }
  }
}
