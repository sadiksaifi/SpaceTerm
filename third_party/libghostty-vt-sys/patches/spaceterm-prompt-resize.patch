+fn clearPromptRows(self: *Screen, first: Pin) void {
+    var it = first.rowIterator(.right_down, self.cursor.page_pin.*);
+    while (it.next()) |pin| {
+        const page = pin.node.page();
+        const row = pin.rowAndCell().row;
