--- a/src/creds/spaceterm-policy.h
+++ b/src/creds/spaceterm-policy.h
@@ -0,0 +1,79 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <errno.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/prctl.h>
+#include <unistd.h>
+
+/* This is the fixed private tool interface, not a general systemd-creds CLI.
+ * Validate before upstream parsing, which can perform device/IPC operations. */
+static int spaceterm_request(int argc, char **argv) {
+        const char *operands[3] = {};
+        unsigned n = 0, seen = 0;
+        bool key = false;
+
+        if (argc == 2 && strcmp(argv[1], "--version") == 0)
+                return 0; /* Non-secret build/loader observation. */
+
+        for (int i = 1; i < argc; i++) {
+                unsigned bit = 0;
+                if (strcmp(argv[i], "--no-ask-password") == 0)
+                        bit = 1;
+                else if (strcmp(argv[i], "--refuse-null") == 0)
+                        bit = 2;
+                else if (strcmp(argv[i], "--newline=no") == 0)
+                        bit = 4;
+                else if (strncmp(argv[i], "--name=spaceterm.boot.", 22) == 0) {
+                        const char *name = argv[i] + 22;
+                        if (strlen(name) != 64 || strspn(name, "0123456789abcdef") != 64)
+                                return -EINVAL;
+                        bit = 8;
+                } else if (strcmp(argv[i], "--with-key=host") == 0 || strcmp(argv[i], "--with-key=host+tpm2") == 0) {
+                        bit = 16;
+                        key = true;
+                } else {
+                        if (n == 3)
+                                return -EOPNOTSUPP;
+                        operands[n++] = argv[i];
+                        continue;
+                }
+                if (seen & bit)
+                        return -EINVAL;
+                seen |= bit;
+        }
+
+        if (n != 3 || (seen & 15) != 15 || strcmp(operands[1], "-") != 0 || strcmp(operands[2], "-") != 0)
+                return -EOPNOTSUPP;
+        if (strcmp(operands[0], "encrypt") == 0)
+                return key ? 1 : -EOPNOTSUPP;
+        if (strcmp(operands[0], "decrypt") == 0)
+                return !key ? 1 : -EOPNOTSUPP;
+        return -EOPNOTSUPP;
+}
+
+static int spaceterm_prepare(int argc, char **argv) {
+        int r;
+
+        /* Exec can reset dumpability. Establish and verify it before any key,
+         * plaintext, option-triggered probe, or library credential operation. */
+        if (prctl(PR_SET_DUMPABLE, 0, 0, 0, 0) < 0 || prctl(PR_GET_DUMPABLE, 0, 0, 0, 0) != 0)
+                return -EPERM;
+        r = spaceterm_request(argc, argv);
+        if (r <= 0)
+                return r;
+        if (geteuid() != 0)
+                return -EPERM; /* Never delegate to Varlink/polkit. */
+        /* Lock stacks, heap, crypto/provider state, and all later allocations.
+         * No best-effort locking or reduced-address-space fallback is allowed.
+         * Retain upstream erase cleanups and EVP context destruction. */
+        if (mlockall(MCL_CURRENT|MCL_FUTURE) < 0)
+                return -EPERM;
+        /* Plaintext must not linger in an unwiped libc stream buffer. */
+        if (setvbuf(stdin, NULL, _IONBF, 0) != 0 || setvbuf(stdout, NULL, _IONBF, 0) != 0)
+                return -EIO;
+        return 0;
+}
