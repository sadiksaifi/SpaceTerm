+/// Remove disposable blank rows at the end of the page list after a prompt
+/// redraw has moved the cursor away from them. Keep history enforcement
+/// deferred while the shell remains at its prompt.
+pub fn finishPromptRedrawPadding(self: *PageList, cursor_pin: Pin) void {
+    if (!self.defer_history_enforcement) return;
+    while (self.total_rows > self.rows and
+        (self.limits.exceeded(self, .lines) or self.limits.exceeded(self, .bytes)))
+    {
+        const last = self.pages.last.?;
+        const page = last.page();
+        const final_y = last.rows() - 1;
+        if (cursor_pin.node == last and cursor_pin.y == final_y) break;
+        for (self.tracked_pins.keys()) |tracked| {
+            if (tracked.node == last and tracked.y == final_y) break;
+        } else {
+            const row = &page.rows.ptr(page.memory.ptr)[final_y];
+            for (page.getCells(row)) |cell| {
+                if (cell.hasText()) break;
+            } else {
+                self.invalidateNodeLayout(last);
+                page.resetRow(row);
+                page.size.rows -= 1;
+                self.total_rows -= 1;
+                if (page.size.rows == 0) self.erasePage(last);
+                self.viewport_pin_row_offset = null;
+                self.fixupViewport(0);
+                continue;
+            }
+        }
+        break;
+    }
+    self.assertIntegrity();
+}
