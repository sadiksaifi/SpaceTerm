{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spaceterm.dev/schema/color-scheme-definitions-v1.schema.json",
  "title": "SpaceTerm color-scheme definitions",
  "$defs": {
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*([._-][a-z0-9]+)*$"
    },
    "customId": {
      "allOf": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "not": {
            "pattern": "^builtin\\."
          }
        }
      ]
    },
    "color": {
      "type": "string",
      "pattern": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$"
    },
    "appearance": {
      "enum": [
        "light",
        "dark"
      ]
    },
    "terminalColors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "foreground": {
          "$ref": "#/$defs/opaqueColor"
        },
        "background": {
          "$ref": "#/$defs/opaqueColor"
        },
        "normal": {
          "$ref": "#/$defs/palette"
        },
        "bright": {
          "$ref": "#/$defs/palette"
        },
        "dim": {
          "$ref": "#/$defs/palette"
        },
        "bright_foreground": {
          "$ref": "#/$defs/opaqueColor"
        },
        "dim_foreground": {
          "$ref": "#/$defs/opaqueColor"
        },
        "cursor": {
          "$ref": "#/$defs/opaqueColor"
        },
        "cursor_text": {
          "$ref": "#/$defs/nullableOpaqueColor"
        },
        "selection_background": {
          "$ref": "#/$defs/color"
        },
        "selection_foreground": {
          "$ref": "#/$defs/nullableOpaqueColor"
        },
        "find_match_background": {
          "$ref": "#/$defs/color"
        },
        "find_match_foreground": {
          "$ref": "#/$defs/nullableOpaqueColor"
        },
        "find_active_match_background": {
          "$ref": "#/$defs/color"
        },
        "find_active_match_foreground": {
          "$ref": "#/$defs/nullableOpaqueColor"
        },
        "hyperlink": {
          "$ref": "#/$defs/color"
        },
        "visual_bell": {
          "$ref": "#/$defs/color"
        }
      }
    },
    "palette": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/opaqueColor"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "opaqueColor": {
      "type": "string",
      "pattern": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{3}[fF]|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{6}[fF]{2})$"
    },
    "nullableOpaqueColor": {
      "oneOf": [
        {
          "$ref": "#/$defs/opaqueColor"
        },
        {
          "type": "null"
        }
      ]
    },
    "schemeOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "family",
        "theme",
        "fingerprint"
      ],
      "properties": {
        "format": {
          "const": "zed"
        },
        "package_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "theme": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      }
    },
    "colorScheme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "appearance",
        "colors"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/customId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "appearance": {
          "$ref": "#/$defs/appearance"
        },
        "author": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "license": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "description": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "colors": {
          "$ref": "#/$defs/terminalColors"
        },
        "origin": {
          "$ref": "#/$defs/schemeOrigin"
        }
      }
    }
  }
}
