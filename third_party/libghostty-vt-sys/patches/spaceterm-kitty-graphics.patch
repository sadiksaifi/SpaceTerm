+/// A fully resolved placement ready for a renderer. Unlike the raw placement
+/// iterator, this includes occurrences produced by Unicode placeholders.
+pub const ResolvedPlacement = extern struct {
+    size: usize = @sizeOf(ResolvedPlacement),
+    image_id: u32 = 0,
+    placement_id: u32 = 0,
+    z: i32 = 0,
+    viewport_col: i32 = 0,
+    viewport_row: i32 = 0,
+    cell_offset_x: u32 = 0,
+    cell_offset_y: u32 = 0,
+    source_x: u32 = 0,
+    source_y: u32 = 0,
+    source_width: u32 = 0,
+    source_height: u32 = 0,
+    dest_width: u32 = 0,
+    dest_height: u32 = 0,
+    is_virtual: bool = false,
+};
+
+pub const ResolvedPlacementCallback = *const fn (
+    userdata: ?*anyopaque,
+    placement: *const ResolvedPlacement,
+) callconv(lib.calling_conv) bool;
+
+/// Advance active-screen animation frames and return the next delay.
+/// The caller supplies a monotonic millisecond clock used for every call.
+pub fn animation_tick(terminal_: terminal_c.Terminal, now_ms: u64, delay_ms: ?*u64) callconv(lib.calling_conv) Result {
+    if (comptime !build_options.kitty_graphics) return .no_value;
+    const wrapper = terminal_ orelse return .invalid_value;
+    const out = delay_ms orelse return .invalid_value;
+    const screen = wrapper.terminal.screens.active;
+    out.* = screen.kitty_images.animationTick(screen.io, now_ms) orelse return .no_value;
+    return .success;
+}
+
+/// Report allocated image payload bytes in primary and alternate screen order.
+pub fn storage_bytes(terminal_: terminal_c.Terminal, bytes_: ?*[2]usize) callconv(lib.calling_conv) Result {
+    const wrapper = terminal_ orelse return .invalid_value;
+    const bytes = bytes_ orelse return .invalid_value;
+    bytes.* = .{ 0, 0 };
+    if (comptime !build_options.kitty_graphics) return .success;
+    inline for (.{ .primary, .alternate }, 0..) |key, index| {
+        if (wrapper.terminal.screens.get(key)) |screen| {
+            bytes[index] = screen.kitty_images.total_bytes;
+        }
+    }
+    return .success;
+}
+
+/// Set independent screen limits without imposing one screen's usage on the other.
+pub fn storage_limits(terminal_: terminal_c.Terminal, primary: usize, alternate: usize) callconv(lib.calling_conv) Result {
+    const wrapper = terminal_ orelse return .invalid_value;
+    if (comptime !build_options.kitty_graphics) return .success;
+    wrapper.terminal.kitty_image_screen_limits = .{ primary, alternate };
+    inline for (.{ .primary, .alternate }, 0..) |key, index| {
+        if (wrapper.terminal.screens.get(key)) |screen| {
+            screen.kitty_images.setLimit(screen.io, screen.alloc, screen, ([2]usize{ primary, alternate })[index]);
+        }
+    }
+    return .success;
+}
+
+/// Visit visible placements using the same geometry rules as Ghostty's renderer.
+pub fn resolved_placements(
+    terminal_: terminal_c.Terminal,
+    userdata: ?*anyopaque,
+    callback_: ?ResolvedPlacementCallback,
+) callconv(lib.calling_conv) Result {
+    if (comptime !build_options.kitty_graphics) return .no_value;
+    const wrapper = terminal_ orelse return .invalid_value;
+    const callback = callback_ orelse return .invalid_value;
+    const t = wrapper.terminal;
+    const storage = &t.screens.active.kitty_images;
+    const top = t.screens.active.pages.getTopLeft(.viewport);
+    const bot = t.screens.active.pages.getBottomRight(.viewport) orelse return .success;
+    const top_y = t.screens.active.pages.pointFromPin(.screen, top).?.screen.y;
+    const alloc = t.gpa();
+    const Storage = @import("../kitty/graphics_storage.zig").ImageStorage;
+    const Pending = struct { key: Storage.PlacementKey, p: Storage.Placement, root_key: Storage.PlacementKey, x: i32, y: i32 };
+    var pending: std.ArrayListUnmanaged(Pending) = .empty;
+    defer pending.deinit(alloc);
+    var origins: std.AutoHashMapUnmanaged(Storage.PlacementKey, struct { x: u32, y: u32 }) = .empty;
+    defer origins.deinit(alloc);
+    var has_virtual = false;
+    var it = storage.placements.iterator();
+    while (it.next()) |entry| {
+        const p = entry.value_ptr;
+        var offset_x: i32 = 0;
+        var offset_y: i32 = 0;
+        const pin = switch (p.location) {
+            .virtual => { has_virtual = true; continue; },
+            .pin => |pin| pin,
+            .relative => |rel| origin: {
+                const chain = storage.resolveChain(rel) orelse continue;
+                switch (chain.root.location) {
+                    .pin => |pin| {
+                        offset_x = chain.horizontal_offset;
+                        offset_y = chain.vertical_offset;
+                        break :origin pin;
+                    },
+                    .virtual => {
+                        has_virtual = true;
+                        pending.append(alloc, .{ .key = entry.key_ptr.*, .p = p.*, .root_key = chain.root_key, .x = chain.horizontal_offset, .y = chain.vertical_offset }) catch return .out_of_memory;
+                        continue;
+                    },
+                    .relative => unreachable,
+                }
+            },
+        };
+        if (pin.garbage) continue;
+        const image = storage.imageById(entry.key_ptr.image_id) orelse continue;
+        const pos = t.screens.active.pages.pointFromPin(.screen, pin.*) orelse continue;
+        const x = @as(i64, pin.x) + offset_x;
+        const y = @as(i64, pos.screen.y) + offset_y - top_y;
+        if (!visitPlacement(t, entry.key_ptr.*, p.*, image, x, y, userdata, callback)) return .success;
+    }
+    if (has_virtual) {
+        var virtual_it = @import("../kitty/graphics_unicode.zig").placementIterator(top, bot);
+        while (virtual_it.next()) |p| {
+            if (pending.items.len > 0) fold: {
+                const target = storage.placeholderTarget(p.image_id, p.placement_id) orelse break :fold;
+                const vp = t.screens.active.pages.pointFromPin(.viewport, p.pin) orelse break :fold;
+                const gop = origins.getOrPut(alloc, target.key) catch return .out_of_memory;
+                if (!gop.found_existing) {
+                    gop.value_ptr.* = .{ .x = vp.viewport.x, .y = vp.viewport.y };
+                } else {
+                    gop.value_ptr.x = @min(gop.value_ptr.x, vp.viewport.x);
+                    gop.value_ptr.y = @min(gop.value_ptr.y, vp.viewport.y);
+                }
+            }
+            const image = storage.imageById(p.image_id) orelse continue;
+            if (image.data.isPending()) continue;
+            const rp = p.renderPlacement(storage, &image, t.width_px / t.cols, t.height_px / t.rows) catch continue;
+            if (rp.dest_width == 0 or rp.dest_height == 0) continue;
+            const viewport = t.screens.active.pages.pointFromPin(.viewport, rp.top_left) orelse continue;
+            const resolved: ResolvedPlacement = .{
+                .image_id = image.id,
+                .placement_id = p.placement_id,
+                .z = -1,
+                .viewport_col = @intCast(rp.top_left.x),
+                .viewport_row = @intCast(viewport.viewport.y),
+                .cell_offset_x = rp.offset_x,
+                .cell_offset_y = rp.offset_y,
+                .source_x = rp.source_x,
+                .source_y = rp.source_y,
+                .source_width = rp.source_width,
+                .source_height = rp.source_height,
+                .dest_width = rp.dest_width,
+                .dest_height = rp.dest_height,
+                .is_virtual = true,
+            };
+            if (!callback(userdata, &resolved)) return .success;
+        }
+        for (pending.items) |pr| {
+            const origin = origins.get(pr.root_key) orelse continue;
+            const image = storage.imageById(pr.key.image_id) orelse continue;
+            if (!visitPlacement(t, pr.key, pr.p, image, @as(i64, origin.x) + pr.x, @as(i64, origin.y) + pr.y, userdata, callback)) return .success;
+        }
+    }
+    return .success;
+}
+
+fn visitPlacement(
+    t: *const terminal_c.ZigTerminal,
+    key: @import("../kitty/graphics_storage.zig").ImageStorage.PlacementKey,
+    p: @import("../kitty/graphics_storage.zig").ImageStorage.Placement,
+    image: @import("../kitty/graphics_image.zig").Image,
+    x: i64,
+    y: i64,
+    userdata: ?*anyopaque,
+    callback: ResolvedPlacementCallback,
+) bool {
+    if (image.data.isPending()) return true;
+    const grid = p.gridSize(image, t);
+    if (grid.cols == 0 or grid.rows == 0) return true;
+    if (y >= t.rows or y + grid.rows - 1 < 0 or x >= t.cols or x + grid.cols - 1 < 0) return true;
+    const dest = p.pixelSize(image, t);
+    if (dest.width == 0 or dest.height == 0) return true;
+    const source = p.sourceRect(image);
+    const offset = p.cellOffset(t);
+    const resolved: ResolvedPlacement = .{
+        .image_id = image.id,
+        .placement_id = key.placement_id.id,
+        .z = p.z,
+        .viewport_col = std.math.cast(i32, x) orelse return true,
+        .viewport_row = std.math.cast(i32, y) orelse return true,
+        .cell_offset_x = offset.x,
+        .cell_offset_y = offset.y,
+        .source_x = source.x,
+        .source_y = source.y,
+        .source_width = source.width,
+        .source_height = source.height,
+        .dest_width = dest.width,
+        .dest_height = dest.height,
+    };
+    return callback(userdata, &resolved);
+}
 
