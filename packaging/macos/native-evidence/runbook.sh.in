#!/bin/sh
# Copy the complete generated sequence into an existing GUI-parented shell only
# after independent review of the exact signed preflight. This is not host consent.
/usr/bin/env -i PATH=/usr/bin:/bin:/usr/sbin:/sbin LC_ALL=C /bin/sh <<'SPACETERM_NATIVE_520'
set -eu
umask 077
STAGE=@STAGE@
ROOT=@ROOT@
OUT=/private/tmp/spaceterm-native-520-@RUN_ID@.jsonl
ACCOUNT_UID=$(/usr/bin/id -u)
BOOTSTRAP_PHASE=0
CLEANUP_ACTIVE=0
FIRST_SIGNAL=0

fail() {
  /usr/bin/printf 'failure=%s\n' "$1" >&2
  exit 1
}
hash_matches() {
  test -f "$2" && test ! -L "$2" || return 1
  observed=$(/usr/bin/shasum -a 256 "$2" 2>/dev/null) || return 1
  case "$observed" in "$1 "*) return 0 ;; *) return 1 ;; esac
}
verified_tool() {
  /usr/bin/sudo @SUDO_MODE@ /usr/bin/env -i PATH=/usr/bin:/bin:/usr/sbin:/sbin LC_ALL=C "$@"
}
verify_admin() {
  # Inspect only the fresh protected copy with trusted OS tools. The preparation
  # observations of account-owned code are not authority for privileged execution.
  observed=$(verified_tool /usr/bin/shasum -a 256 "$1" 2>/dev/null) || return 1
  case "$observed" in '@ADMIN_DIGEST@ '*) ;; *) return 1 ;; esac
  verified_tool /usr/bin/codesign --verify --strict --all-architectures -R @ADMIN_REQUIREMENT@ "$1" >/dev/null 2>&1 || return 1
  details=$(verified_tool /usr/bin/codesign --display --verbose=4 "$1" 2>&1) || return 1
  /usr/bin/printf '%s\n' "$details" | /usr/bin/awk '
    /^CodeDirectory / && /flags=0x[0-9a-fA-F]+\([^)]*runtime[^)]*\)/ {ok=1}
    END {exit !ok}' || return 1
  entitlements=$(verified_tool /usr/bin/codesign --display --entitlements :- "$1" 2>/dev/null) || return 1
  if test -n "$entitlements"; then
    parsed=$(/usr/bin/printf '%s\n' "$entitlements" | /usr/bin/plutil -convert json -o - - 2>/dev/null) || return 1
    test "$parsed" = '{}' || return 1
  fi
  libraries=$(verified_tool /usr/bin/otool -L "$1" 2>/dev/null) || return 1
  /usr/bin/printf '%s\n' "$libraries" | /usr/bin/awk '
    NR == 1 {next}
    {sub(/^[ \t]+/, ""); sub(/ \(.*/, ""); count++}
    !/^\/usr\/lib\// && !/^\/System\/Library\/Frameworks\// {bad=1}
    /\/\.\.\// {bad=1}
    END {exit (bad || !count)}' || return 1
  commands=$(verified_tool /usr/bin/otool -l "$1" 2>/dev/null) || return 1
  case "$commands" in *LC_RPATH*|*LC_DYLD_ENVIRONMENT*) return 1 ;; esac
  architecture=$(verified_tool /usr/bin/lipo -archs "$1" 2>/dev/null) || return 1
  test "$architecture" = arm64 || return 1
}
protected_ancestor() {
  test -d "$1" && test ! -L "$1" || return 1
  owner=$(/usr/bin/stat -f %u "$1" 2>/dev/null) || return 1
  mode=$(/usr/bin/stat -f %Lp "$1" 2>/dev/null) || return 1
  test "$owner" = 0 || return 1
  case "$mode" in ''|*[!0-7]*) return 1 ;; esac
  test "$((0$mode & 0022))" -eq 0 || return 1
  # Reject ACL-bearing ancestors. This bootstrap never interprets grants.
  /bin/ls -lde "$1" 2>/dev/null | /usr/bin/awk 'NR == 1 && $1 !~ /\+/ {ok=1; next} {ok=0} END {exit !ok}'
}
admin() {
  verify_admin "$ROOT/evidence-admin" || return 1
  /usr/bin/sudo @SUDO_MODE@ /usr/bin/env -i PATH=/usr/bin:/bin:/usr/sbin:/sbin LC_ALL=C \
    "$ROOT/evidence-admin" "$@" >/dev/null 2>&1
}
cleanup() {
  case "$BOOTSTRAP_PHASE" in
    0) return 0 ;;
    1) return 1 ;; # Root creation was interrupted; ownership is unresolved.
    2) ;;
    *) return 1 ;;
  esac
  # An incomplete bootstrap or unavailable native retirement remains for recovery.
  # Never remove a root, receipt, helper, or fixture based on a utility exit alone.
  admin uninstall || return 1
}
finish() {
  status=$?
  trap - EXIT
  CLEANUP_ACTIVE=1
  if ! cleanup; then
    /usr/bin/printf 'failure=cleanup-unresolved\n' >&2
    exit 75
  fi
  if test "$FIRST_SIGNAL" -ne 0; then
    exit "$((128 + FIRST_SIGNAL))"
  fi
  exit "$status"
}
cancel() {
  if test "$FIRST_SIGNAL" -eq 0; then
    FIRST_SIGNAL=$1
    if test "$CLEANUP_ACTIVE" -eq 0; then
      exit "$((128 + FIRST_SIGNAL))"
    fi
  fi
}
trap finish EXIT
trap 'cancel 2' INT
trap 'cancel 15' TERM
trap 'cancel 1' HUP

case "$ACCOUNT_UID" in ''|0|*[!0-9]*) fail identity-mismatch ;; esac
test ! -e "$OUT" && test ! -L "$OUT" || fail unsafe-native-state
test ! -e "$ROOT" && test ! -L "$ROOT" || fail unsafe-native-state
protected_ancestor / || fail unsafe-native-state
protected_ancestor /Library || fail unsafe-native-state
protected_ancestor '/Library/Application Support' || fail unsafe-native-state
# The digest literals bind the exact candidate, not a caller's parsed selector.
@VERIFY_CANDIDATE@
@SUDO_VALIDATE@
BOOTSTRAP_PHASE=1
if /usr/bin/sudo @SUDO_MODE@ /bin/mkdir -m 0700 "$ROOT" >/dev/null 2>&1; then
  BOOTSTRAP_PHASE=2
else
  # A failed exclusive mkdir does not authorize uninstalling another run's root.
  BOOTSTRAP_PHASE=0
  fail unsafe-native-state
fi
# Bootstrap metadata is not native authority. The authenticated admin must bind
# the native account and durably publish its full receipt before any fixture effect.
/usr/bin/printf '%s\n' '@BOOTSTRAP_RECEIPT@' | \
  /usr/bin/sudo @SUDO_MODE@ /usr/bin/tee "$ROOT/bootstrap-receipt.json" >/dev/null 2>&1 || fail io-unavailable
# Read candidate bytes as the account, never as root. A substituted source symlink
# cannot make a trusted root copier disclose a root-readable file. Bound the copy.
/bin/dd if="$STAGE/evidence-admin" bs=65536 count=@COPY_BLOCKS@ 2>/dev/null | \
  /usr/bin/sudo @SUDO_MODE@ /usr/bin/tee "$ROOT/evidence-admin" >/dev/null 2>&1 || fail io-unavailable
/usr/bin/sudo @SUDO_MODE@ /bin/chmod 0555 "$ROOT/evidence-admin" >/dev/null 2>&1 || fail io-unavailable
# The root is 0700, so full native policy verification runs through sanitized
# trusted OS tools with sudo. No staging or protected fixture is executed yet.
verify_admin "$ROOT/evidence-admin" || fail artifact-rejected
# Allow account traversal only after the immutable admin has been authenticated.
/usr/bin/sudo @SUDO_MODE@ /bin/chmod 0755 "$ROOT" >/dev/null 2>&1 || fail io-unavailable
verify_admin "$ROOT/evidence-admin" || fail artifact-rejected
# Install refuses service, registration, credential, and fixture collisions before
# effects, authenticates fresh protected copies, and owns the durable cleanup receipt.
admin install --account-uid "$ACCOUNT_UID" --candidate "$STAGE" || fail native-unavailable
# The native client creates OUT exclusively and validates every bounded record.
# It must observe GUI/session context. SSH or a successful utility exit is not proof.
/usr/bin/env -i PATH=/usr/bin:/bin:/usr/sbin:/sbin LC_ALL=C \
  "$ROOT/evidence-client" @CLIENT_MODE@ --output "$OUT" 2>/dev/null || fail outcome-pending
# EXIT performs idempotent receipt-bound cleanup, including when output failed.
SPACETERM_NATIVE_520
