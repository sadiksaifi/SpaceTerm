        </defaults>
        <annotate key="org.freedesktop.policykit.exec.path">@MANAGER_PATH@</annotate>
        <annotate key="org.freedesktop.policykit.exec.argv1">restart</annotate>
    </action>
    <action id="@SERVER_IDENTIFIER@.manage.uninstall">
        <description>SpaceTerm Server: uninstall</description>
        <message>Authorize SpaceTerm Server uninstall</message>
        <defaults>
            <allow_any>auth_admin</allow_any>
